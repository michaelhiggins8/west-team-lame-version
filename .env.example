# Contact form (/api/contact)

# Required. Resend API key — https://resend.com/api-keys
# Without it the endpoint returns 503 "Messaging is temporarily unavailable".
RESEND_API_KEY=

# Optional. Where inquiries are delivered.
# Defaults to traceylarue212@gmail.com
CONTACT_TO_EMAIL=

# Optional. Verified Resend sender.
# Defaults to "West Team <onboarding@resend.dev>", which Resend only allows to
# send to the account owner's own address. Set this to a verified domain (or an
# onboarding@resend.dev alias) once the domain is set up.
CONTACT_FROM_EMAIL=
